{
    "name": "fast-copier",
    "version": "1.0.0",
    "description": "Quickly copy inline code, formatted text, links, and tags.",
    "author": "Kevin",
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/TracingOrigins/obsidian-fast-copier-plugin.git"
    },
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "node scripts/deploy.mjs dev && node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/deploy.mjs build",
        "version": "node version-bump.mjs && git add package.json package-lock.json manifest.json versions.json",
        "lint": "eslint ."
    },
    "config": {
        "tag-version-prefix": ""
    },
    "keywords": [
        "copy",
        "copier",
        "fast copier",
        "Obsidian Plugin"
    ],
    "devDependencies": {
        "@codemirror/state": "^6.5.0",
        "@codemirror/view": "^6.38.6",
        "@eslint/js": "^9.39.4",
        "@types/node": "^26.1.2",
        "@typescript-eslint/parser": "^8.59.1",
        "esbuild": "^0.28.1",
        "eslint": "^9.39.4",
        "eslint-plugin-obsidianmd": "^0.4.0",
        "globals": "^17.6.0",
        "obsidian": "1.13.1",
        "tsx": "^4.23.5",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.59.1"
    }
}
